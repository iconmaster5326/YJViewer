{% extends "page.j2" %} {% import "fragments/cardcard.j2" as cardcard %}

<span>{% block title %}{{ series.name[en] }} - YGOJSON{% endblock %}</span>

{% block contents %}
<div class="container">
  <div class="row">
    <h1 id="name-label" class="col-auto fw-bold text-decoration-underline">
      {{ series.name[en] }}
    </h1>
    <div class="col text-end">
      <h2>
        {% if series.archetype %}Archetype{% else %}Series{% endif %} ({{
          series.members | length
        }}
        members)
      </h2>
      {% if series.yugipedia %}
      <h5>
        Yugipedia:
        <a href="https://yugipedia.com/wiki/{{ series.yugipedia.name }}"
          >{{ series.yugipedia.name }} ({{ series.yugipedia.id }})</a
        >
      </h5>
      {% endif %}
      <script>
        function updateText(langname, name) {
          document.getElementById("lang-toggle").innerText = langname;
          document.getElementById("name-label").innerText = name;
        }
      </script>
      <form class="dropdown" autocomplete="off">
        <button
          id="lang-toggle"
          class="btn btn-secondary dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          English
        </button>
        <ul class="dropdown-menu">
          {% for lang in series | setlangs %}
          <li class="px-2">
            <a class="dropdown-item" href="#" onclick="updateText('{{lang | translateenum }}', '{{ series.name[lang] | jsescape }}')">
              {{ lang | translateenum }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </form>
    </div>
  </div>
  <div class="row">
    {% for member in series.members %}
    <div class="col-6 col-sm-4 col-lg-3 col-xl-2">
      {{ cardcard.cardcard(member, en) }}
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
